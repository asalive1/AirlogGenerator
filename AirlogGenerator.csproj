<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>AG.ico</ApplicationIcon>

    <!-- Versioning -->
    <AssemblyVersion>1.1.17.0</AssemblyVersion>
    <FileVersion>1.1.17.0</FileVersion>
    <InformationalVersion>1.1.17</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Publish behavior -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Prevent duplicate Windows/Linux publish output -->
    <DisableRuntimeIdentifierInference>true</DisableRuntimeIdentifierInference>

    <!-- Docker tooling -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>

    <!-- Optional: let VS choose -->
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>

    <UserSecretsId>daa467cc-d392-43f8-8b38-113590aab5e2</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
	<PackageReference Include="AWSSDK.SecretsManager" Version="3.7.300.5" />
	<PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <!-- Ensure all deployment files are included without duplicates -->
  <ItemGroup>

    <!-- Move docker-compose.yml up one folder during publish -->
    <Content Update="docker-compose.yml">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>..\docker-compose.yml</TargetPath>
    </Content>

    <!-- Move ag-install.sh up one folder during publish -->
    <Content Update="ag-install.sh">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>..\ag-install.sh</TargetPath>
    </Content>

    <!-- Keep Dockerfile inside AirlogGenerator folder -->
    <Content Update="Dockerfile">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <!-- Copy CONFIG folder into AirlogGenerator -->
    <Content Update="CONFIG\**\*.*">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

  </ItemGroup>

</Project>