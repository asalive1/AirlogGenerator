<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Versioning -->
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.6.1</FileVersion>
    <InformationalVersion>1.0.6</InformationalVersion>

    <!-- Publish settings - framework-dependent for Docker -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    
    <!-- Windows-specific settings (only for local Windows builds) -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>

    <UseAppHost>true</UseAppHost>
    <PublishReadyToRun>false</PublishReadyToRun>
    <UserSecretsId>daa467cc-d392-43f8-8b38-113590aab5e2</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

</Project>